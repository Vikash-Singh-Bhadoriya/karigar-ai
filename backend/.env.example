PORT=5000

# Postgres connection string for the marketplace catalog. Secret — backend-only.
DATABASE_URL=

# Legacy Gemini key (used only if no numbered keys below are configured).
GEMINI_API_KEY=

# Gemini API keys tried in order for failover (numbered keys preferred).
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# Product analysis model (falls back to GEMINI_MODEL).
GEMINI_PRODUCT_MODEL=
GEMINI_MODEL=gemini-3.1-flash-lite

# Speech transcription model.
GEMINI_SPEECH_MODEL=gemini-3.5-transcribe

# Supabase (backend-only; used for persistent marketplace product images).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=product-images

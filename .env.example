# KarigarAI mobile — backend connection
# Copy this file to `.env` (same folder) and set your backend URL.
#
# Use your computer's LAN IP address (NOT localhost) so your phone can reach it.
# Your phone and computer must be on the same Wi-Fi network.
#
# IMPORTANT:
# - backend runs on PORT 5000  ->  http://<LAN-IP>:5000
# - 8081 is the Expo/Metro dev server, NOT the backend. Do not point here.
# Find the IP: run `ipconfig` on Windows, look under your Wi-Fi adapter.
EXPO_PUBLIC_API_URL=http://192.168.1.100:5000
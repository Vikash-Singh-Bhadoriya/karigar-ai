# ─────────────────────────────────────────────────────────────
# Supabase (public/anon key — safe for client-side use)
# Used for Realtime product updates on the buyer website.
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─────────────────────────────────────────────────────────────
# Backend API URL — the Render backend base URL.
#
# LOCAL DEV  : Leave empty or set to http://localhost:5000
#              The Vite dev server proxy handles /api/* → localhost:5000
#              automatically, so empty string works fine.
#
# PRODUCTION : Set to the full Render URL (no trailing slash):
#              VITE_API_URL=https://karigar-ai-backend.onrender.com
#
# SECURITY   : This is the public backend URL. It is safe to expose.
#              DO NOT put DATABASE_URL, SUPABASE_SECRET_KEY,
#              or any Gemini API keys here.
# ─────────────────────────────────────────────────────────────
VITE_API_URL=
